{
  "version": 1,
  "name": "Nord",
  "author": "dupitydumb",
  "description": "Arctic, north-bluish color palette. Clean and elegant dark theme.",
  "accentColor": "#88c0d0",
  "mode": "dark",
  "customColors": {
    "bgBase": "#2e3440",
    "bgElevated": "#3b4252",
    "bgSurface": "#434c5e",
    "bgHighlight": "#4c566a",
    "textPrimary": "#eceff4",
    "textSecondary": "#d8dee9",
    "textSubdued": "#81a1c1",
    "borderColor": "#4c566a",
    "sidebarBg": "#2e3440",
    "playerBg": "#3b4252"
  },
  "background": {
    "type": "none",
    "value": "",
    "opacity": 1,
    "blur": 0,
    "fixed": false
  },
  "animation": {
    "reducedMotion": false,
    "pageTransition": "fade",
    "playerVisualization": "bars",
    "hoverScale": true,
    "accentPulse": true,
    "transitionSpeed": "normal"
  }
}
