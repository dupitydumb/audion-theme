{
  "version": 1,
  "name": "Winter Frost",
  "author": "dupitydumb",
  "description": "Crisp icy palette with gentle falling snowflakes and soft winter glow.",
  "accentColor": "#a5f3fc",
  "mode": "dark",
  "customColors": {
    "bgBase": "#080e1a",
    "bgElevated": "#0f172a",
    "bgSurface": "#1e293b",
    "bgHighlight": "#334155",
    "textPrimary": "#f0f9ff",
    "textSecondary": "#bae6fd",
    "textSubdued": "#7dd3fc",
    "borderColor": "#1e293b",
    "sidebarBg": "#060a12",
    "playerBg": "#0b1320"
  },
  "background": {
    "type": "gradient",
    "value": "linear-gradient(180deg, #080e1a 0%, #0c192e 60%, #060b14 100%)",
    "opacity": 1,
    "blur": 0,
    "fixed": true
  },
  "animation": {
    "reducedMotion": false,
    "pageTransition": "fade",
    "playerVisualization": "wave",
    "hoverScale": true,
    "accentPulse": true,
    "transitionSpeed": "slow"
  },
  "customJs": "const count = 75;\nconst flakes = Array.from({ length: count }, () => ({\n  x: Math.random() * canvas.width,\n  y: Math.random() * canvas.height,\n  r: Math.random() * 2.5 + 0.8,\n  speedY: Math.random() * 0.9 + 0.4,\n  speedX: (Math.random() - 0.5) * 0.4,\n  opacity: Math.random() * 0.6 + 0.2\n}));\nlet animId;\nfunction render() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  for (const f of flakes) {\n    f.y += f.speedY;\n    f.x += f.speedX + Math.sin(f.y * 0.02) * 0.3;\n    if (f.y > canvas.height + 5) {\n      f.y = -5;\n      f.x = Math.random() * canvas.width;\n    }\n    if (f.x > canvas.width) f.x = 0;\n    if (f.x < 0) f.x = canvas.width;\n    ctx.fillStyle = `rgba(224, 242, 254, ${f.opacity})`;\n    ctx.beginPath();\n    ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  animId = requestAnimationFrame(render);\n}\nrender();\nreturn () => cancelAnimationFrame(animId);"
}
